# Windows container (WCOW) image for the registry.
#
# This image reuses the cross-compiled registry.exe produced by the Linux
# `artifact-all` bake target (windows/amd64), so the released binary and the
# containerized binary are identical. Build it natively on a Windows runner
# whose OS version matches WINDOWS_VERSION (process isolation), e.g.
#   docker build -f Dockerfile.windows --build-arg WINDOWS_VERSION=ltsc2022 -t <img> <ctx>
# where <ctx> contains registry.exe and config.yml alongside this file.
#
# Runtime note: a Windows container's base image OS must match the host's OS, or
# the container fails to start with "The container operating system does not match
# the host operating system". See:
#   https://learn.microsoft.com/en-us/virtualization/windowscontainers/deploy-containers/version-compatibility
# The multi-arch manifest handles this: a host pulls the variant matching its own
# OS and architecture (the ltsc2022 and ltsc2025 entries carry distinct os.version
# values).
#
# Prior art for building the registry as a Windows image:
#   https://github.com/sixeyed/dockerfiles-windows/blob/master/registry/nanoserver/1809/Dockerfile
#   https://github.com/StefanScherer/dockerfiles-windows/blob/main/registry/Dockerfile
#   https://github.com/docker/distribution-library-image/pull/42
#   https://github.com/docker/distribution/pull/2281
#   https://github.com/olljanat/multi-win-version-aspnet (multiarch Windows images; moby/moby#35247)

# WINDOWS_VERSION selects the nanoserver base image tag (ltsc2022, ltsc2025).
ARG WINDOWS_VERSION=ltsc2022

FROM mcr.microsoft.com/windows/nanoserver:${WINDOWS_VERSION}

EXPOSE 5000

ENTRYPOINT ["\\registry.exe"]
CMD ["serve", "C:\\etc\\distribution\\config.yml"]

# The storage rootdirectory in config.yml (/var/lib/registry -> C:\var\lib\registry)
# does not collide with the binary at \registry.exe.
COPY registry.exe /registry.exe
COPY config.yml /etc/distribution/config.yml
